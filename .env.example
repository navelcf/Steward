# 应用
APP_NAME=Steward
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001

# 日志
LOGGING_LEVEL=INFO

# 数据库（B 部分起 PG 时会用到；密码只用字母和数字）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=steward
DB_USER=steward
DB_PASSWORD=CHANGE_ME
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# 鉴权（Day 3 用；必须至少 32 位随机字符串）
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=120


# 注意，chat_model等属性会发生变化，具体信息必须参照模型官方文档！
# 模型（Day 6）；2026-11-15 按 DeepSeek 官方「首次调用 API」页核对
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
# 思考模式：enabled / disabled；默认关掉，理由见教程 3.6.3
CHAT_THINKING=disabled
# temperature 在思考模式不生效；这里默认已关闭思考，所以 0.3 才有效
CHAT_TEMPERATURE=0.3
# 单文档全文读上限（ADR-03 产品阈值），不是模型能力上限
MAX_DOC_TOKENS=80000