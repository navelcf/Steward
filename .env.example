# 应用
APP_NAME=Steward
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001

# 日志
LOGGING_LEVEL=INFO

# 数据库（B 部分起 PG 时会用到；密码只用字母和数字）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=steward
DB_USER=steward
DB_PASSWORD=CHANGE_ME
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# 鉴权（Day 3 用；必须至少 32 位随机字符串）
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=120